generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Translated fields have Uz / Ru / En columns; an empty one falls back to another language (lib/i18n.ts).
model Project {
  id              String   @id @default(cuid())
  titleUz         String?
  titleRu         String?
  titleEn         String?
  descriptionUz   String?
  descriptionRu   String?
  descriptionEn   String?
  imageUrl        String?
  backendStack    String?
  frontendStack   String?
  noteUz          String?
  noteRu          String?
  noteEn          String?
  repoUrl         String?
  frontendRepoUrl String?
  demoUrl         String?
  sortOrder       Int      @default(0)
  published       Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([published, sortOrder])
}

model SocialLink {
  id         String   @id @default(cuid())
  platform   String
  url        String
  label      String?
  showInHero Boolean  @default(false)
  sortOrder  Int      @default(0)
  published  Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([published, sortOrder])
}

model Message {
  id        String   @id @default(cuid())
  name      String
  email     String
  body      String
  /// sha256 of the sender IP, only used for rate limiting
  ipHash    String?
  /// Set when the message is an offer for a domain from the "Domains for sale" section
  domain    String?
  offer     Int?
  currency  String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([read, createdAt])
  @@index([ipHash, createdAt])
}

model Post {
  id          String      @id @default(cuid())
  titleUz     String?
  titleRu     String?
  titleEn     String?
  slug        String      @unique
  excerptUz   String?
  excerptRu   String?
  excerptEn   String?
  /// Markdown
  contentUz   String?
  contentRu   String?
  contentEn   String?
  coverUrl    String?
  published   Boolean     @default(false)
  publishedAt DateTime?
  views       Int         @default(0)
  shares      Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  events      PostEvent[]

  @@index([published, publishedAt])
}

/// One row per visitor, post, kind and day, so reloads do not inflate Post.views / Post.shares.
model PostEvent {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  /// "view" or "share"
  kind      String
  /// sha256 of the client IP
  ipHash    String
  /// UTC date, YYYY-MM-DD
  day       String
  createdAt DateTime @default(now())

  @@unique([postId, kind, ipHash, day])
  @@index([createdAt])
}

/// Failed admin logins, used to rate limit password guessing.
model LoginAttempt {
  id        String   @id @default(cuid())
  /// sha256 of the client IP
  ipHash    String
  createdAt DateTime @default(now())

  @@index([ipHash, createdAt])
  @@index([createdAt])
}

/// Skill groups on the home page ("Backend", "Tools", ...).
model SkillCategory {
  id        String   @id @default(cuid())
  titleUz   String?
  titleRu   String?
  titleEn   String?
  /// Bootstrap Icons class, e.g. bi-cloud
  icon      String
  sortOrder Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  skills    Skill[]

  @@index([sortOrder])
}

model Skill {
  id         String        @id @default(cuid())
  name       String
  categoryId String
  category   SkillCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  /// Icon image URL (usually a devicon SVG)
  icon       String
  sortOrder  Int           @default(0)
  published  Boolean       @default(true)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([categoryId, sortOrder])
}

/// Domains for sale, shown at /{lang}/domains; offers arrive as Messages.
model Domain {
  id            String   @id @default(cuid())
  /// Lowercase, e.g. example.uz
  name          String   @unique
  /// Asking price in whole units of `currency`; empty means "make an offer"
  price         Int?
  /// USD or UZS
  currency      String   @default("USD")
  descriptionUz String?
  descriptionRu String?
  descriptionEn String?
  sold          Boolean  @default(false)
  sortOrder     Int      @default(0)
  published     Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([published, sortOrder])
}
