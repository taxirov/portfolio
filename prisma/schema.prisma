generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Project {
  id              String   @id @default(cuid())
  title           String
  description     String
  imageUrl        String?
  backendStack    String?
  frontendStack   String?
  note            String?
  repoUrl         String?
  frontendRepoUrl String?
  demoUrl         String?
  sortOrder       Int      @default(0)
  published       Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([published, sortOrder])
}

model SocialLink {
  id         String   @id @default(cuid())
  platform   String
  url        String
  label      String?
  showInHero Boolean  @default(false)
  sortOrder  Int      @default(0)
  published  Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([published, sortOrder])
}

model Message {
  id        String   @id @default(cuid())
  name      String
  email     String
  body      String
  /// sha256 of the sender IP, only used for rate limiting
  ipHash    String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([read, createdAt])
  @@index([ipHash, createdAt])
}

model Post {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String?
  /// Markdown
  content     String
  coverUrl    String?
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([published, publishedAt])
}

/// Failed admin logins, used to rate limit password guessing.
model LoginAttempt {
  id        String   @id @default(cuid())
  /// sha256 of the client IP
  ipHash    String
  createdAt DateTime @default(now())

  @@index([ipHash, createdAt])
  @@index([createdAt])
}
