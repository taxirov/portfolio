# Postgres connection string for local development.
# On Netlify leave it unset: Netlify Database provides NETLIFY_DB_URL automatically.
DATABASE_URL="postgresql://user:password@localhost:5432/portfolio"

# Admin panel (app.saad.uz)
ADMIN_PASSWORD="change-me"
# At least 32 random characters: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=""

# Host that serves the admin panel
ADMIN_HOST="app.saad.uz"


# Optional: Telegram notification for new contact form messages.
# Create a bot with @BotFather, send it any message, then get your chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Optional, local only: separate shadow database for `prisma migrate dev`
# SHADOW_DATABASE_URL=""
